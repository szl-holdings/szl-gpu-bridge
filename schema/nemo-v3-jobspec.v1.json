            "previousEngineKeyId": {"const": "5c6cf59741ade920"},
            "recoveryIssueUrl": {"const": "https://github.com/szl-holdings/szl-gpu-bridge/issues/25"},
            "rotationMode": {"const": "LOST_PRIVATE_KEY_NEW_GENERATION"},
            "oldKeyStatus": {"const": "VERIFY_ONLY"},
            "decisionAt": {"type": "string", "format": "date-time"}
          }
        },
        {
          "type": "object",
          "required": [
            "engineKeyId",
            "previousEngineKeyId",
            "recoveryIssueUrl",
            "rotationMode",
            "oldKeyStatus",
            "decisionAt",
