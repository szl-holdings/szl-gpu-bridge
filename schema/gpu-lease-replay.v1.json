{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/szl-holdings/szl-gpu-bridge/blob/main/schema/gpu-lease-replay.v1.json",
  "title": "SZL original simulated GPU lease protocol input",
  "description": "Source-only synthetic replay. No production or hardware admission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "memory_limit_mib",
    "checkpoint",
    "tail",
    "events"
  ],
  "properties": {
    "schema": {
      "const": "szl.gpu-lease-replay/v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "upstream_revision",
        "evidence_kind"
      ],
      "properties": {
        "repository": {
          "const": "szl-holdings/szl-gpu-bridge"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "upstream_revision": {
          "const": "9eb66b9c68a3e449fdb3b2bd6edf3ddf6bd6d2ca"
        },
        "evidence_kind": {
          "const": "SYNTHETIC"
        }
      }
    },
    "memory_limit_mib": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice_overhead_us",
        "overhead_budget_ppm",
        "pause_target_us",
        "publication_us",
        "drain_us",
        "ack_us"
      ],
      "properties": {
        "slice_overhead_us": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "overhead_budget_ppm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999
        },
        "pause_target_us": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "publication_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "drain_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "ack_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "tail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "samples",
        "slowdown_budget_ppm",
        "risk_budget_ppm",
        "confidence_ppm"
      ],
      "properties": {
        "samples": {
          "type": "array",
          "minItems": 300,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "baseline_us",
              "shared_us"
            ],
            "properties": {
              "baseline_us": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000000
              },
              "shared_us": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000000
              }
            }
          }
        },
        "slowdown_budget_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500000
        },
        "risk_budget_ppm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "confidence_ppm": {
          "type": "integer",
          "minimum": 500000,
          "maximum": 999999
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 96,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/prepare"
          },
          {
            "$ref": "#/$defs/grant"
          },
          {
            "$ref": "#/$defs/complete"
          },
          {
            "$ref": "#/$defs/revoke"
          },
          {
            "$ref": "#/$defs/ack"
          },
          {
            "$ref": "#/$defs/reader_add"
          },
          {
            "$ref": "#/$defs/reader_done"
          },
          {
            "$ref": "#/$defs/retire"
          },
          {
            "$ref": "#/$defs/publish_epoch"
          }
        ]
      }
    }
  },
  "$defs": {
    "prepare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "task",
        "generation",
        "epoch",
        "backend",
        "trusted",
        "memory_mib"
      ],
      "properties": {
        "op": {
          "const": "prepare"
        },
        "task": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "backend": {
          "enum": [
            "finite_sliced",
            "cooperative_resident"
          ]
        },
        "trusted": {
          "const": true
        },
        "memory_mib": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "task",
        "generation",
        "epoch",
        "start",
        "extent"
      ],
      "properties": {
        "op": {
          "const": "grant"
        },
        "task": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "extent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "complete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "task",
        "generation",
        "epoch",
        "grant_id",
        "committed",
        "completion_digest"
      ],
      "properties": {
        "op": {
          "const": "complete"
        },
        "task": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "grant_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "committed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "completion_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "revoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "task",
        "generation",
        "epoch"
      ],
      "properties": {
        "op": {
          "const": "revoke"
        },
        "task": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "task",
        "generation",
        "epoch"
      ],
      "properties": {
        "op": {
          "const": "ack"
        },
        "task": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "reader_add": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "task",
        "generation",
        "epoch"
      ],
      "properties": {
        "op": {
          "const": "reader_add"
        },
        "task": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "reader_done": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "task",
        "generation",
        "epoch"
      ],
      "properties": {
        "op": {
          "const": "reader_done"
        },
        "task": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "retire": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "task",
        "generation",
        "epoch"
      ],
      "properties": {
        "op": {
          "const": "retire"
        },
        "task": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "publish_epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "next_epoch"
      ],
      "properties": {
        "op": {
          "const": "publish_epoch"
        },
        "next_epoch": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2147483647
        }
      }
    }
  }
}
