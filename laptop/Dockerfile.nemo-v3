# syntax=docker/dockerfile:1.7
FROM pytorch/pytorch@sha256:417bd75df6365104c283ea4c1651fb3530d9eb5a4c2fafa51943cff2a94e6385

ENV HF_HUB_DISABLE_TELEMETRY=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TOKENIZERS_PARALLELISM=false

RUN python -m pip install --no-cache-dir \
      "bitsandbytes==0.50.0" \
      "datasets==4.3.0" \
      "huggingface_hub==1.24.0" \
      "peft==0.19.1" \
      "PyNaCl==1.6.2" \
      "trl==0.24.0" \
      "unsloth==2026.7.4" \
      "unsloth-zoo==2026.7.4" \
      "xformers==0.0.32.post2" \
    && python -m pip check

ARG BRIDGE_REVISION
LABEL org.opencontainers.image.title="SZL Nemo v3 governed training environment" \
      org.opencontainers.image.revision="${BRIDGE_REVISION}" \
      org.opencontainers.image.source="https://github.com/szl-holdings/szl-gpu-bridge"

ENTRYPOINT ["python"]
